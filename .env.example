# Copy this file to .env and fill in real values. Never commit .env.

# "development" (default) or "production"
APP_ENV=development

# Signs login cookies. REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Which AI answers the chats: "gemini" (cloud, fake data only) or "local" (Ollama on this machine)
LLM_PROVIDER=gemini

# Local model settings (used when LLM_PROVIDER=local). Install: https://ollama.com
#   ollama pull qwen3.5:4b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Max seconds per model call. CPU-only laptops need a lot (20-60 s per answer).
OLLAMA_TIMEOUT=180
# How long the model stays loaded in RAM after the last chat ("30m", "2h", "-1" = forever)
OLLAMA_KEEP_ALIVE=30m
# How many earlier chat messages the local model sees (fewer = faster, less copying of old answers)
OLLAMA_MAX_HISTORY=6
# The model's working memory in tokens (more = more RAM). Input beyond it is cut off.
OLLAMA_NUM_CTX=4096

# Gemini settings (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
# Optional: main model (Flash-Lite has the highest free-tier limits)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: backup models (comma-separated), used when a model is busy, out of quota or retired
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash,gemini-3-flash-preview

# Optional
# LOG_LEVEL=INFO
# SESSION_HOURS=8
# TRUST_PROXY=1            # set when running behind nginx / a load balancer
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
# CHAT_MAX_PER_MINUTE=20
