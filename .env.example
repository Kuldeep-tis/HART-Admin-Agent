# Copy this file to .env and fill in real values. Never commit .env.

# "development" (default) or "production"
APP_ENV=development

# Signs login cookies. REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

GEMINI_API_KEY=your-gemini-api-key
# Optional: main model (Flash-Lite has the highest free-tier limits)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: backup models (comma-separated), used when a model is busy, out of quota or retired
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash,gemini-3-flash-preview

# Optional
# LOG_LEVEL=INFO
# SESSION_HOURS=8
# TRUST_PROXY=1            # set when running behind nginx / a load balancer
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
# CHAT_MAX_PER_MINUTE=20
